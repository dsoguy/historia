# Auto detect text files and perform LF normalization
*          text=auto

#
# The above will handle all files NOT found below
#

# Documents
*.rtf      diff=astextplain
*.RTF      diff=astextplain
*.md       text diff=markdown
*.csv      text
*.txt      text
*.sql      text

# Graphics as binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.tif      binary
*.tiff     binary
*.ico      binary
*.eps      binary

# Graphics as text
*.svg      text
*.drawio   text

# Scripts
*.bash     text eol=lf
*.sh       text eol=lf
*.zsh      text eol=lf
# These are explicitly windows files and should use crlf
*.ps1      text eol=crlf

# Serialisation
*.json     text
*.xml      text

# Archives
*.7z       binary
*.gz       binary
*.tar      binary
*.tgz      binary
*.zip      binary

# Exclude files from exporting
.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore
.*.drawio.bkp  export-ignore
